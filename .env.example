# Copy to `.env.local` and fill in to enable a real global leaderboard.
# Without these vars the game falls back to the local-only ladder.

# Base URL of the leaderboard service. Required to enable the global board.
# e.g. https://grapple-gliders-leaderboard.<your-subdomain>.workers.dev
VITE_LEADERBOARD_API_URL=

# Optional bearer token sent as `Authorization: Bearer <key>` on every request.
# Useful for write-rate-limiting or basic auth on the submit endpoint.
VITE_LEADERBOARD_API_KEY=

# Optional path overrides. Defaults match the reference Cloudflare Worker.
# VITE_LEADERBOARD_FETCH_PATH=/leaderboard/{date}
# VITE_LEADERBOARD_SUBMIT_PATH=/leaderboard
